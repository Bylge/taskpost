# LF everywhere — in the repository and in the working tree. CI and the WSL2 working copy
# the repo moves into at M1 are both Linux (08-environment.md).
* text=auto eol=lf

# Language-aware diffs. From the Laravel skeleton; its export-ignore block is not carried
# over, because nothing here is ever installed as a Composer package.
*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php
